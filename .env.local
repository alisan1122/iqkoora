# ==========================================
# IQ KOORA - إعدادات ومتغيرات البيئة المحلية (.env.local)
# ==========================================

# اسم التطبيق والبيئة
NEXT_PUBLIC_APP_NAME="IQ KOORA"
NEXT_PUBLIC_APP_ENV="development"

# إعدادات الـ Football API المباشر
NEXT_PUBLIC_FOOTBALL_API_URL="https://site.api.espn.com/apis/site/v2/sports/soccer"
NEXT_PUBLIC_FOOTBALL_DATA_API_KEY=""

# سيرفرات البث المباشر HLS الافتراضية
NEXT_PUBLIC_HLS_STREAM_SERVER_1="https://kora.depoooo.com/albaplayer/bein-1/"
NEXT_PUBLIC_HLS_STREAM_SERVER_2="https://kora.depoooo.com/albaplayer/bein-1/"
NEXT_PUBLIC_HLS_STREAM_SERVER_3="https://kora.depoooo.com/albaplayer/bein-1/"

# إعدادات التحديث التلقائي (بالملي ثانية)
NEXT_PUBLIC_REFRESH_INTERVAL=60000
